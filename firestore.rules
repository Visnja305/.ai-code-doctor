rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.token.email == userId || request.auth.uid == userId);
      match /{subcollection=**} {
        allow read, write: if request.auth != null && (request.auth.token.email == userId || request.auth.uid == userId);
      }
    }
  }
}


